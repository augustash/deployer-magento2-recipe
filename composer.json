{
    "name": "augustash/deployer-magento2-recipe",
    "description": "Magento 2.4 Recipe for Deployer",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Peter McWilliams",
            "email": "pmcwilliams@augustash.com"
        },
        {
            "name": "Josh Johnson",
            "email": "josh@augustash.com"
        }
    ],
    "homepage": "https://github.com/augustash/deployer-magento2-recipe",
    "require": {
        "php": "^8.0 || ^7.3",
        "deployer/deployer": ">=7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "stable",
    "autoload": {
        "files": [
            "autoload.php"
        ],
        "psr-4": {
            "Augustash\\Deployer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Augustash\\Deployer\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
